{
  "name": "ramen-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web; wait",
    "dev:api": "bun run --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "lint": "oxlint",
    "test": "bun test",
    "db:migrate": "bun run server/db/migrate.ts",
    "auth:generate": "bunx @better-auth/cli@latest generate --config server/auth.ts -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@elysiajs/eden": "^1.0.0",
    "@elysiajs/static": "^1.0.0",
    "@libsql/client": "^0.14.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@tanstack/react-query": "^5.0.0",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.0.0",
    "kysely": "^0.27.0",
    "lucide-react": "^1.39.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
