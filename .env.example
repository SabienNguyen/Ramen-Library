# Copy to .env and fill in. .env is gitignored; this file is the reference.

# --- Database ---------------------------------------------------------------
# Dev: a local libSQL file. Production: the sqld container's HTTP endpoint,
# reachable from other containers on the compose network as http://sqld:8080.
DATABASE_URL=file:data/ramen.db
# Only needed if sqld is started with --auth-jwt-key-file (auth enabled).
# Empty means no auth token is sent.
DATABASE_AUTH_TOKEN=

# --- Object storage (Garage, S3-compatible) ---------------------------------
# Leave S3_ENDPOINT empty in dev to fall back to local disk storage
# (server/storage.ts writes under UPLOAD_DIR and serves /uploads).
# In production, point it at Garage's S3 API, reachable from other
# containers as http://garage:3900.
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=ramen-uploads
# From `garage key create` (see deploy/garage.toml's setup steps in the
# README's Deploy section).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL images are served from, i.e. wherever Caddy proxies to
# Garage's web endpoint (garage:3902). Production example:
#   S3_PUBLIC_URL=https://img.yourdomain.tld
# Local docker-compose.local.yml example:
#   S3_PUBLIC_URL=http://localhost:8081
S3_PUBLIC_URL=

# Local-disk upload directory, used only when S3_ENDPOINT is empty.
UPLOAD_DIR=data/uploads

# --- Auth ---------------------------------------------------------------
# Better Auth session/cookie signing secret. Generate with:
#   openssl rand -base64 32
# Required in production; any placeholder works for local dev.
BETTER_AUTH_SECRET=dev-only-placeholder-change-me
# Origin the app is served from. Dev: the Vite dev server. Production: your
# real domain (must match what's in deploy/Caddyfile). Local docker-compose
# full-stack test: http://localhost (see docker-compose.local.yml).
BETTER_AUTH_URL=http://localhost:5173
# Extra origins Better Auth should trust, beyond BETTER_AUTH_URL's origin
# and the Vite dev defaults (http://localhost:5173, http://127.0.0.1:5173).
# Comma-separated. Usually unnecessary.
TRUSTED_ORIGINS=

# --- Server ---------------------------------------------------------------
# Dev: bind to localhost only. Ignored when running under Docker Compose —
# docker-compose.yml sets HOST=0.0.0.0 and PORT=3000 on the app service's
# `environment:` block, which overrides these .env values.
PORT=3000
HOST=127.0.0.1

# --- Rate limiting --------------------------------------------------------
# Set to 1 only when behind Caddy or another reverse proxy that sets
# X-Forwarded-For itself (e.g. docker-compose.yml's app service) — trusting
# it otherwise lets clients spoof their rate-limit key. Leave empty in local
# dev, where requests reach the app directly.
TRUST_PROXY=

# --- Email --------------------------------------------------------------
# Transactional email provider API key (Resend), used to send
# verification emails via server/email.ts. Empty disables sending —
# verification links are only logged to the console, and
# requireEmailVerification stays false either way.
EMAIL_PROVIDER_KEY=
